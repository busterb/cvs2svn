# (Be in -*- mode: python; coding: utf-8 -*- mode.)

# Options file for the external_blob_generator_keywords regression
# test: convert this fixture to git using CVSRevisionReader (the
# subprocess-based path) with keyword expansion turned on, so its
# output can be diffed against cvs2git-external.options's output
# (same fixture, same keyword handling, but via ExternalBlobGenerator).
#
# Load the fully-functional example file for boilerplate, then
# override just the project path, keyword handling, and revision
# collector.

execfile('cvs2git-example.options')

run_options.set_project(
    r'test-data/internal-co-keywords-cvsrepos',
    symbol_strategy_rules=global_symbol_strategy_rules,
    )

# Override the example's file property setters (which default keyword
# handling to 'collapsed') so that every file uses 'expanded' -- the
# mode that actually exercises _KeywordExpander, and the one that is
# load-bearing for real CVS repositories with $Id$/$OpenBSD$-style
# markers.
ctx.file_property_setters = [KeywordHandlingPropertySetter('expanded')]

# Leave ctx.tmpdir at the example's default ('cvs2git-tmp'); tests run
# sequentially within one process, and ctx.output_option's
# dump_filename was already bound to that path above, so overriding
# ctx.tmpdir here without also rebuilding ctx.output_option would
# leave the blob and dump files in different directories.
ctx.revision_collector = GitRevisionCollector(
    CVSRevisionReader(cvs_executable=r'cvs'),
    blob_filename=os.path.join(ctx.tmpdir, 'git-blob.dat'),
    )
